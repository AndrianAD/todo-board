# GitHub repo where data/board.json lives (owner/org and repo name)
VITE_GITHUB_OWNER=your-github-username
VITE_GITHUB_REPO=todo-board

# Branch that holds data/board.json (default: main)
VITE_GITHUB_BRANCH=main

# Path to the JSON file used as the "database" (default: data/board.json)
VITE_GITHUB_DATA_PATH=data/board.json

# Fine-grained Personal Access Token, scoped to this ONE repo only, with
# "Contents: Read and write" permission and nothing else. Required for
# writing (adding tasks/users, dragging cards). Without it the app is
# read-only. NEVER commit a real token - see README.md for the security
# trade-off of embedding it in the client bundle.
VITE_GITHUB_PAT=
